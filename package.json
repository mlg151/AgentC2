{
  "name": "agentc2",
  "version": "0.4.1",
  "private": true,
  "description": "Desktop SSH manager for Codex, Claude, and Antigravity CLI sessions",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "npm run build && electron-builder --publish never",
    "test:terminal": "npm run build && node tests/terminal.e2e.cjs",
    "test:launch-modes": "node tests/launch-modes.cjs",
    "test:productivity": "node tests/productivity.cjs",
    "test:workspace": "npm run build && node tests/workspace.e2e.cjs",
    "test:remote": "npm run build && node tests/remote-control.cjs",
    "test:companion": "npm run build && node tests/companion.e2e.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test:platform": "node tests/platform.cjs",
    "test:desktop": "node tests/desktop.e2e.cjs",
    "test:package": "node tests/desktop.e2e.cjs --packaged",
    "test:ci": "npm run build && npm run test:productivity && node tests/remote-control.cjs && npm run test:platform"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "@electron/osx-sign": "1.3.3"
  },
  "build": {
    "appId": "com.agentc2.desktop",
    "productName": "AgentC2",
    "directories": {
      "output": "release"
    },
    "npmRebuild": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico"
    },
    "buildDependenciesFromSource": true,
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/app-icon.png",
      "category": "Development",
      "executableName": "agentc2",
      "maintainer": "mlg151 <mlg151@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/app-icon.icns",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0.0",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "publish": null
  },
  "author": "mlg151",
  "homepage": "https://github.com/mlg151/AgentC2",
  "desktopName": "agentc2.desktop"
}
