{
  "name": "agentc2",
  "version": "0.4.14",
  "private": true,
  "description": "Desktop SSH manager for Codex, Claude, and Antigravity CLI sessions",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "npm run build && electron-builder --publish never",
    "test:terminal": "npm run build && node tests/terminal.e2e.cjs",
    "test:chat": "npm run build && node tests/chat-protocol.cjs && node tests/chat-service.cjs && node tests/chat-timeline.cjs",
    "test:launch-modes": "node tests/launch-modes.cjs",
    "test:claude-gated": "node tests/claude-gated.cjs",
    "test:oporders": "npm run build && python3 tests/oporders.py && node tests/oporders.e2e.cjs && node tests/oporders.ui.e2e.cjs",
    "test:sitrep": "npm run build && python3 tests/sitrep.py && node tests/sitrep.e2e.cjs",
    "test:exercises": "npm run build && node tests/exercises.cjs && python3 tests/exercises.py && node tests/exercises.e2e.cjs",
    "test:flash": "npm run build && python3 tests/flash.py && node tests/flash.e2e.cjs",
    "test:loop-breaker": "npm run build && node tests/loop-breaker.cjs && python3 tests/loop-breaker.py && node tests/loop-breaker.e2e.cjs",
    "test:productivity": "node tests/productivity.cjs",
    "test:workspace": "npm run build && node tests/workspace.e2e.cjs",
    "test:remote": "npm run build && node tests/remote-control.cjs",
    "test:companion": "npm run build && node tests/companion.e2e.cjs",
    "test:cleanup": "npm run build && node tests/cleanup.e2e.cjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test:platform": "node tests/platform.cjs",
    "test:desktop": "node scripts/run-tests.cjs desktop",
    "test:package": "node scripts/run-tests.cjs packaged",
    "test:ci": "npm run build && node scripts/run-tests.cjs core",
    "test:chat:runtime": "python3 tests/chat-runtime.py",
    "test:chat:upgrade": "python3 tests/chat-upgrade.py -v",
    "test:chat:ui": "node tests/chat-ui.e2e.cjs",
    "test:desktop:sessions": "npm run build && node tests/desktop-sessions.e2e.cjs",
    "test:chat:ssh": "npm run build && node tests/chat-launch.e2e.cjs",
    "test:chat:sdk-evaluation": "python3 tests/antigravity-sdk-evaluation.py",
    "test:companion:filters": "npm run build && node tests/companion-filters.e2e.cjs",
    "test:chat:local": "npm run build && cross-env AGENTC2_CHAT_TEST_LOCAL=1 node tests/chat-launch.e2e.cjs",
    "test:specops": "node tests/specops.cjs && python3 tests/github.py",
    "test:specops:ui": "npm run build && node tests/specops.ui.e2e.cjs",
    "test:windows:local": "npm run build && node tests/windows-local.e2e.cjs",
    "test:centcom": "node tests/centcom.cjs && node tests/centcom-operations.cjs && node tests/centcom-schema.cjs && node tests/centcom-doctrine.cjs && node tests/centcom-support.cjs && node tests/centcom-history.cjs && node tests/centcom-missions.cjs && node tests/centcom-launch.cjs && node tests/centcom-evidence.cjs && node tests/centcom-turn.cjs && node tests/centcom-automations.cjs && node tests/centcom-bindings.cjs",
    "test:inventory": "node scripts/run-tests.cjs --validate",
    "test:coverage": "cross-env AGENTC2_COVERAGE=1 AGENTC2_SOURCE_COVERAGE=1 npm run build && node scripts/coverage.cjs",
    "test:coverage:report": "node scripts/coverage.cjs report"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.9",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "c8": "12.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "istanbul-lib-instrument": "6.0.3",
    "js-yaml": "4.3.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.agentc2.desktop",
    "productName": "AgentC2",
    "directories": {
      "output": "release"
    },
    "npmRebuild": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico"
    },
    "buildDependenciesFromSource": true,
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/app-icon.png",
      "category": "Development",
      "executableName": "agentc2",
      "maintainer": "mlg151 <mlg151@users.noreply.github.com>",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/app-icon.icns",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "13.0.0",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "mlg151",
      "repo": "AgentC2",
      "releaseType": "release"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "tmux",
        "python3 (>= 3.10)",
        "openssh-client"
      ]
    }
  },
  "author": "mlg151",
  "homepage": "https://github.com/mlg151/AgentC2",
  "desktopName": "agentc2.desktop"
}
