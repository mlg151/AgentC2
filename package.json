{
  "name": "agentc2",
  "version": "0.4.1",
  "private": true,
  "description": "SSH desktop manager for Codex, Claude, and Antigravity CLI sessions",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "test:terminal": "npm run build && node tests/terminal.e2e.cjs",
    "test:launch-modes": "node tests/launch-modes.cjs",
    "test:productivity": "node tests/productivity.cjs",
    "test:workspace": "npm run build && node tests/workspace.e2e.cjs",
    "test:remote": "npm run build && node tests/remote-control.cjs",
    "test:companion": "npm run build && node tests/companion.e2e.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.agentc2.desktop",
    "productName": "AgentC2",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico"
    }
  }
}
